{
  "name": "stack-papa",
  "services": {
    "victor-delta-0": {
      "image": "registry.example.com/charlie/group-0:latest",
      "container_name": "victor-delta-0",
      "restart": "unless-stopped",
      "command": [
        "dotnet",
        "victor-delta-0.dll",
        "--urls",
        "http://0.0.0.0:8080"
      ],
      "ports": [
        "8000:8080",
        "9000:9090"
      ],
      "environment": {
        "ASPNETCORE_ENVIRONMENT": "Production",
        "ConnectionStrings__Default": "Host=db-0;Database=oscar;Username=app",
        "LOG_LEVEL": "info",
        "RETRIES": "5"
      },
      "volumes": [
        "./data/victor-delta-0:/var/lib/victor-delta-0",
        "/etc/localtime:/etc/localtime:ro"
      ],
      "networks": [
        "backend"
      ],
      "labels": {
        "com.example.team": "papa",
        "com.example.group": "group-0"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-f",
          "http://localhost:8080/health"
        ],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3,
        "start_period": "10s"
      }
    },
    "echo-bravo-1": {
      "image": "registry.example.com/charlie/group-0:latest",
      "container_name": "echo-bravo-1",
      "restart": "unless-stopped",
      "ports": [
        "8001:8080",
        "9001:9090"
      ],
      "environment": {
        "ASPNETCORE_ENVIRONMENT": "Production",
        "ConnectionStrings__Default": "Host=db-0;Database=oscar;Username=app",
        "LOG_LEVEL": "info",
        "RETRIES": "5"
      },
      "volumes": [
        "./data/echo-bravo-1:/var/lib/echo-bravo-1",
        "/etc/localtime:/etc/localtime:ro"
      ],
      "networks": [
        "backend"
      ],
      "labels": {
        "com.example.team": "papa",
        "com.example.group": "group-0"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-f",
          "http://localhost:8080/health"
        ],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3,
        "start_period": "10s"
      }
    }
  },
  "networks": {
    "backend": {
      "driver": "bridge"
    }
  }
}
