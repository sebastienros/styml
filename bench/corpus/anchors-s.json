{
  "name": "stack-juliet",
  "services": {
    "yankee-delta-0": {
      "image": "registry.example.com/kilo/group-0:latest",
      "container_name": "yankee-delta-0",
      "restart": "unless-stopped",
      "command": [
        "dotnet",
        "yankee-delta-0.dll",
        "--urls",
        "http://0.0.0.0:8080"
      ],
      "ports": [
        "8000:8080",
        "9000:9090"
      ],
      "environment": {
        "ASPNETCORE_ENVIRONMENT": "Production",
        "ConnectionStrings__Default": "Host=db-0;Database=zulu;Username=app",
        "LOG_LEVEL": "info",
        "RETRIES": "5"
      },
      "volumes": [
        "./data/yankee-delta-0:/var/lib/yankee-delta-0",
        "/etc/localtime:/etc/localtime:ro"
      ],
      "networks": [
        "backend"
      ],
      "labels": {
        "com.example.service": "yankee-delta-0"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-f",
          "http://localhost:8080/health"
        ],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3,
        "start_period": "10s"
      }
    },
    "lima-uniform-1": {
      "image": "registry.example.com/kilo/group-0:latest",
      "container_name": "lima-uniform-1",
      "restart": "unless-stopped",
      "ports": [
        "8001:8080",
        "9001:9090"
      ],
      "environment": {
        "ASPNETCORE_ENVIRONMENT": "Production",
        "ConnectionStrings__Default": "Host=db-0;Database=zulu;Username=app",
        "LOG_LEVEL": "info",
        "RETRIES": "5"
      },
      "volumes": [
        "./data/lima-uniform-1:/var/lib/lima-uniform-1",
        "/etc/localtime:/etc/localtime:ro"
      ],
      "networks": [
        "backend"
      ],
      "labels": {
        "com.example.service": "lima-uniform-1"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-f",
          "http://localhost:8080/health"
        ],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3,
        "start_period": "10s"
      }
    },
    "hotel-kilo-2": {
      "image": "registry.example.com/kilo/group-0:latest",
      "container_name": "hotel-kilo-2",
      "restart": "unless-stopped",
      "command": [
        "dotnet",
        "hotel-kilo-2.dll",
        "--urls",
        "http://0.0.0.0:8080"
      ],
      "ports": [
        "8002:8080",
        "9002:9090"
      ],
      "environment": {
        "ASPNETCORE_ENVIRONMENT": "Production",
        "ConnectionStrings__Default": "Host=db-0;Database=zulu;Username=app",
        "LOG_LEVEL": "info",
        "RETRIES": "5"
      },
      "volumes": [
        "./data/hotel-kilo-2:/var/lib/hotel-kilo-2",
        "/etc/localtime:/etc/localtime:ro"
      ],
      "networks": [
        "backend"
      ],
      "labels": {
        "com.example.service": "hotel-kilo-2"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-f",
          "http://localhost:8080/health"
        ],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3,
        "start_period": "10s"
      }
    }
  },
  "networks": {
    "backend": {
      "driver": "bridge"
    }
  }
}
