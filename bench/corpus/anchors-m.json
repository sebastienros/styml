    "echo-mike-0": {
      "image": "registry.example.com/whiskey/group-0:latest",
      "container_name": "echo-mike-0",
      "restart": "unless-stopped",
      "command": [
        "dotnet",
        "echo-mike-0.dll",
        "--urls",
        "http://0.0.0.0:8080"
      ],
      "ports": [
        "8000:8080",
        "9000:9090"
      ],
      "environment": {
        "ASPNETCORE_ENVIRONMENT": "Production",
        "ConnectionStrings__Default": "Host=db-0;Database=romeo;Username=app",
        "LOG_LEVEL": "info",
        "RETRIES": "5"
      },
      "volumes": [
        "./data/echo-mike-0:/var/lib/echo-mike-0",
        "/etc/localtime:/etc/localtime:ro"
      ],
      "networks": [
        "backend"
      ],
      "labels": {
        "com.example.service": "echo-mike-0"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-f",
          "http://localhost:8080/health"
        ],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3,
        "start_period": "10s"
      }
    },
