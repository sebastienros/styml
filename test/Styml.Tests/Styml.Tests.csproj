  <!-- Derived from upstream tests/System.Text.Json.Tests/System.Text.Json.Tests.csproj (renamed). Compile item
       groups are upstream's verbatim (BitStack.cs repointed at src/Styml). References (M2). -->

  <PropertyGroup>
    <TargetFrameworks>$(StymlTestTargetFrameworks)</TargetFrameworks>
    <AssemblyName>Styml.Tests</AssemblyName>
    <RootNamespace>System.Text.Yaml.Tests</RootNamespace>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- SYSLIB0020: YamlSerializerOptions.IgnoreNullValues is obsolete -->
    <NoWarn>$(NoWarn);SYSLIB0020</NoWarn>
    <!-- SYSLIB0049: YamlSerializerOptions.AddContext is obsolete -->
    <NoWarn>$(NoWarn);SYSLIB0049</NoWarn>
    <!-- Disable analyzers warnings about JSON being misformatted in string literals -->
    <NoWarn>$(NoWarn);JSON001</NoWarn>
    <IncludeRemoteExecutor>true</IncludeRemoteExecutor>
    <UsesJsonSchemaNet>true</UsesJsonSchemaNet>
    <!-- Disable nullability public only feature for NullabilityInfoContextTests -->
    <Features>$(Features.Replace('nullablePublicOnly', ''));updated-memory-safety-rules</Features>
    <!-- https://github.com/dotnet/runtime/issues/126862 -->
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
  </PropertyGroup>

