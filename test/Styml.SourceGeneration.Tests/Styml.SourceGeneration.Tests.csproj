       + System.Text.Json.SourceGeneration.Tests.targets (renamed). Compile item groups verbatim. -->
  <PropertyGroup>
    <TargetFrameworks>$(StymlTestTargetFrameworks)</TargetFrameworks>
    <AssemblyName>Styml.SourceGeneration.Tests</AssemblyName>
    <TestedRoslynVersion>4.4</TestedRoslynVersion>
    <Features>$(Features);updated-memory-safety-rules</Features>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <IncludeRemoteExecutor>true</IncludeRemoteExecutor>
    <UsesJsonSchemaNet>true</UsesJsonSchemaNet>
    <!-- Source gen tests target AOT so we disable reflection everywhere for consistency. -->
    <YamlSerializerIsReflectionEnabledByDefault>false</YamlSerializerIsReflectionEnabledByDefault>
    <!-- SYSLIB0020: YamlSerializerOptions.IgnoreNullValues is obsolete -->
    <!-- SYSLIB0049: YamlSerializerOptions.AddContext is obsolete -->
    <!-- STYML1030: Suppress warnings from unsupported types -->
    <!-- STYML1034: Suppress YamlStringEnumConverter use warnings -->
    <!-- STYML1039: Suppress Polymorphic types not supported warning -->
    <!-- STYML1220: Suppress invalid YamlConverterAttribute argument warnings -->
    <!-- STYML1223: Suppress derived YamlConverterAttribute warnings -->
    <!-- STYML1225: Suppress warnings from skipped ref struct members -->
    <!-- STYML1226: Suppress YamlIgnoreCondition.Always on type warning (tested explicitly) -->
    <NoWarn>$(NoWarn);SYSLIB0020;SYSLIB0049;STYML1030;STYML1034;STYML1037;STYML1039;STYML1220;STYML1223;STYML1225;STYML1226</NoWarn>
    <DefineConstants>$(DefineConstants);BUILDING_SOURCE_GENERATOR_TESTS</DefineConstants>
  </PropertyGroup>

