<Project Sdk="Microsoft.NET.Sdk">
  <!-- The trimming and Native AOT smoke app: a source-generated round trip with reflection off by the feature
       switch. Publish it with -p:SmokeMode=Trim or -p:SmokeMode=Aot (.github/workflows/aot.yml); trim and AOT
       warnings are errors, and it exits 0 when every check passes. The switches are set here, not on the command
       line, so that they do not reach the referenced netstandard2.0 projects. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(NetCoreAppCurrent)</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Reflection-based serialization off, as a trimmed or AOT consumer of the package would set it. -->
    <YamlSerializerIsReflectionEnabledByDefault>false</YamlSerializerIsReflectionEnabledByDefault>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PublishTrimmed Condition="'$(SmokeMode)' == 'Trim'">true</PublishTrimmed>
    <PublishAot Condition="'$(SmokeMode)' == 'Aot'">true</PublishAot>
    <IlcTreatWarningsAsErrors Condition="'$(SmokeMode)' == 'Aot'">true</IlcTreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src\Styml\Styml.csproj" />
    <ProjectReference Include="$(RepoRoot)src\Styml.SourceGeneration\Styml.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- The package brings this file through buildTransitive; a ProjectReference imports it. -->
  <Import Project="$(RepoRoot)src\Styml\buildTransitive\Styml.targets" />
</Project>
