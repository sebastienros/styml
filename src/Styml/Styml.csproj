<Project Sdk="Microsoft.NET.Sdk">
  <!-- Derived from upstream src/System.Text.Json.csproj (renamed). The Compile item groups below are the
       upstream ones verbatim except that $(LibrariesProjectRoot)System.Collections\src\ is repointed at
       $(VendoredSystemCollectionsDir). Project/package references are replaced (M2). -->

  <PropertyGroup>
    <TargetFrameworks>$(NetCoreAppCurrent);$(NetCoreAppPrevious);netstandard2.0</TargetFrameworks>
    <AssemblyName>Styml</AssemblyName>
    <RootNamespace>System.Text.Yaml</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS8969</NoWarn>
    <!-- CS0282: Utf8YamlReader's YAML fields live in the Utf8YamlReader.Yaml.cs partial (M3: YAML code in new
         files). Field order is irrelevant for this ref struct (never marshalled or laid out explicitly). -->
    <NoWarn>$(NoWarn);CS0282</NoWarn>
    <IncludeInternalObsoleteAttribute>true</IncludeInternalObsoleteAttribute>
    <IncludeSpanPolyfills>true</IncludeSpanPolyfills>
    <!-- Upstream: IsNETCoreAppSrc implies SkipLocalsInit on .NETCoreApp. -->
    <SkipLocalsInit>true</SkipLocalsInit>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>Styml</PackageId>
    <!-- The version: VersionPrefix here; CI previews add VersionSuffix (preview.<run>), a release tag sets Version. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Sébastien Ros</Authors>
    <Copyright>Copyright (c) 2026 Sébastien Ros. Portions Copyright (c) .NET Foundation and Contributors.</Copyright>
    <PackageDescription>The System.Text.Json API, for YAML. A YAML 1.2 reader, writer, document model and serializer: Utf8YamlReader, Utf8YamlWriter, YamlDocument, YamlNode, YamlSerializer and a source generator. Derived from System.Text.Json (dotnet/runtime v11.0.0); not a Microsoft product.</PackageDescription>
    <PackageTags>yaml;yaml-1.2;serialization;serializer;parser;system.text.json;source-generator;aot</PackageTags>
    <PackageProjectUrl>https://github.com/sebastienros/styml</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sebastienros/styml</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- M7c: the trim and AOT analyzers on the
       .NETCoreApp targets; every warning is fixed or justified in place. -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
