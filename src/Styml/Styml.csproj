  <!-- Single (Roslyn 4.4) source generator, shipped inside the package. Every reference to the generator leaves its
       target framework to the SDK's negotiation (no SetTargetFramework): the project has one, so each caller then
       evaluates it with the solution's own global properties, and a parallel build has one instance of it, not two
       writing the same obj and bin folders. -->
  <ItemGroup>
    <ProjectReference Include="..\Styml.SourceGeneration\Styml.SourceGeneration.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
    <None Include="$(RepoRoot)assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(RepoRoot)THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" Visible="false" />
    <None Include="buildTransitive\Styml.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <Target Name="PackSourceGenerator" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\Styml.SourceGeneration\Styml.SourceGeneration.csproj" Targets="GetTargetPath" RemoveProperties="TargetFramework;RuntimeIdentifier">
      <Output TaskParameter="TargetOutputs" ItemName="_StymlGeneratorAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_StymlGeneratorAssembly)" Pack="true" PackagePath="analyzers\dotnet\cs\" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- The yaml-test-suite trace adapter reads Complex keys through Utf8YamlReader.CreateKeyReader (internal until
         M5). -->
    <InternalsVisibleTo Include="Styml.Yaml.Tests" />
  </ItemGroup>
