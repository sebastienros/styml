<Project>
  <!-- Replacement for Arcade's GenerateResxSource as used by dotnet/runtime (eng/resources.targets):
       Resources/Strings.resx -> 'internal static partial class System.SR' with one property per resource,
       a ResourceManager over the marker type 'FxResources.<name>.SR', and no GetResourceString (that comes
       from the vendored Common/src/System/SR.cs). Microsoft.CodeAnalysis.ResxSourceGenerator was tried first but
       cannot emit the FxResources marker type that product code references via typeof(). -->

  <PropertyGroup>
    <StringResourcesPath Condition="'$(StringResourcesPath)' == '' and Exists('$(MSBuildProjectDirectory)\Resources\Strings.resx')">$(MSBuildProjectDirectory)\Resources\Strings.resx</StringResourcesPath>
    <StringResourcesName Condition="'$(StringResourcesName)' == ''">FxResources.$(AssemblyName).SR</StringResourcesName>
    <_StringResourcesSourceFile>$(IntermediateOutputPath)SR.g.cs</_StringResourcesSourceFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(StringResourcesPath)' != ''">
    <EmbeddedResource Include="$(StringResourcesPath)" LogicalName="$(StringResourcesName).resources" />
    <Compile Include="$(CommonPath)System\SR.cs" Link="Resources\Common\SR.cs" />
  </ItemGroup>

  <UsingTask TaskName="StymlGenerateResxSource" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ResxFile ParameterType="System.String" Required="true" />
      <ResourcesName ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string markerNamespace = ResourcesName.Substring(0, ResourcesName.LastIndexOf('.'));
        string markerClass = ResourcesName.Substring(ResourcesName.LastIndexOf('.') + 1);
        var sb = new StringBuilder();
        sb.AppendLine("// <auto-generated/>");
        sb.AppendLine("#nullable enable");
        sb.AppendLine("namespace " + markerNamespace);
        sb.AppendLine("{");
        sb.AppendLine("    internal static class " + markerClass + " { }");
        sb.AppendLine("}");
        sb.AppendLine("namespace System");
        sb.AppendLine("{");
        sb.AppendLine("    internal static partial class SR");
        sb.AppendLine("    {");
        sb.AppendLine("        private static global::System.Resources.ResourceManager? s_resourceManager;");
        sb.AppendLine("        internal static global::System.Resources.ResourceManager ResourceManager => s_resourceManager ?? (s_resourceManager = new global::System.Resources.ResourceManager(typeof(global::" + ResourcesName + ")));");
        foreach (XElement data in XDocument.Load(ResxFile).Root.Elements("data"))
        {
            string name = (string)data.Attribute("name");
            if (data.Attribute("type") != null || data.Attribute("mimetype") != null) continue;
            string value = (string)data.Element("value") ?? "";
            string summary = new XText(value.Replace("\r", "").Replace("\n", " ")).ToString();
            sb.AppendLine("        /// <summary>" + summary + "</summary>");
            sb.AppendLine("        internal static string @" + name + " => GetResourceString(\"" + name + "\");");
        }
        sb.AppendLine("    }");
        sb.AppendLine("}");
        string text = sb.ToString();
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != text)
        {
            Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
            File.WriteAllText(OutputFile, text);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="StymlGenerateResxSource"
          Condition="'$(StringResourcesPath)' != ''"
          BeforeTargets="CoreCompile"
          DependsOnTargets="PrepareForBuild"
          Inputs="$(StringResourcesPath);$(MSBuildThisFileFullPath)"
          Outputs="$(_StringResourcesSourceFile)">
    <StymlGenerateResxSource ResxFile="$(StringResourcesPath)" ResourcesName="$(StringResourcesName)" OutputFile="$(_StringResourcesSourceFile)" />
  </Target>

  <Target Name="StymlAddResxSource" Condition="'$(StringResourcesPath)' != ''" BeforeTargets="CoreCompile" AfterTargets="StymlGenerateResxSource">
    <ItemGroup>
      <Compile Include="$(_StringResourcesSourceFile)" />
      <FileWrites Include="$(_StringResourcesSourceFile)" />
    </ItemGroup>
  </Target>
</Project>
