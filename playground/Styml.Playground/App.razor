<div class="page @(_showOptions ? "options-open" : null)">
    <header class="toolbar">
        <a class="brand" href="../" title="Styml documentation">
            <img src="logo.svg" alt="" width="28" height="28" />
            <span class="brand-name">st<span class="brand-yml">yml</span></span><span class="brand-sub">playground</span>
        </a>

        <label class="field">
            <span class="field-label">Sample</span>
            <select value="@_sampleId" @onchange="OnSampleChanged" aria-label="Sample">
                @if (_sampleId.Length == 0)
                {
                    <option value="">Custom</option>
                }
                @foreach (var sample in PlaygroundSamples.All)
                {
                    <option value="@sample.Id">@sample.Name</option>
                }
            </select>
        </label>

        <div class="actions">
            <button type="button" class="button" @onclick="ShareAsync" title="Copy a link to this input, its view and its options">@_shareLabel</button>
            <button type="button" class="button @(_showOptions ? "active" : null)" @onclick="() => _showOptions = !_showOptions" aria-expanded="@(_showOptions ? "true" : "false")" aria-controls="options">
                Options@(_changedOptions > 0 ? $" ({_changedOptions})" : null)
            </button>
            <a class="icon-button" href="../guide/getting-started/" title="Documentation" aria-label="Documentation">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4.5h9.5L19 9v10.5H5Z"/><path d="M14 4.5V9h5M8.5 13h7M8.5 16.5h7"/></svg>
            </a>
            <button type="button" class="icon-button" @onclick="ToggleThemeAsync" title="Switch between dark and light theme" aria-label="Switch between dark and light theme">
                <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
                <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
            </button>
        </div>
    </header>

    <main class="workspace">
        <section class="pane editor-pane" aria-label="Input">
            <div class="tabs" role="tablist">
                <button type="button" role="tab" class="tab active" aria-selected="true">input.yaml</button>
            </div>
            <CodeEditor Label="YAML input" Language="PlaygroundLanguage.Yaml" Value="@_yaml" ValueChanged="OnYamlChanged" />
        </section>

        <section class="pane output" aria-label="Output">
            <div class="tabs" role="tablist">
                @foreach (var view in Views)
                {
                    <button type="button" role="tab" class="tab @(_view == view.View ? "active" : null)" aria-selected="@(_view == view.View ? "true" : "false")" title="@view.Title" @onclick="() => OnViewChanged(view.View)">@view.Name</button>
                }
                @if (_view == PlaygroundView.Tree && _result?.Error is null)
                {
                    <label class="tab-toggle" title="Show the style, the anchor and the tag of every node">
                        <input type="checkbox" checked="@_details" @onchange="e => _details = IsChecked(e)" /> Details
                    </label>
                }
                <button type="button" class="tab tab-copy" @onclick="CopyOutputAsync" disabled="@(_result is null || _result.Error is not null || _view is PlaygroundView.Tree or PlaygroundView.Tokens)">@_copyLabel</button>
            </div>

            @if (_result?.Error is { } error)
            {
                <div class="error" role="alert">
                    <p class="error-kind">@(_view == PlaygroundView.Tokens ? "Reader error" : "YAML error")@(error.Line is { } line ? $", line {line}" : null)@(error.Column is { } column ? $", column {column}" : null)</p>
                    <pre>@error.Message</pre>
                </div>
            }
            else if (_view == PlaygroundView.Tree)
            {
                <div class="tree @(_details ? "tree-details" : null)">
                    @for (var i = 0; i < _result?.Trees.Count; i++)
                    {
                        var tree = _result.Trees[i];
                        @if (_result.Trees.Count > 1)
                        {
                            <p class="tree-document">Document @(i + 1)</p>
                        }
                        @if (tree is null)
                        {
                            <p class="tree-empty">An empty document: no value.</p>
                        }
                        else
                        {
                            <ul class="tree-root">@RenderNode(tree)</ul>
                        }
                    }
                </div>
            }
            else if (_view == PlaygroundView.Tokens)
            {
                <div class="tokens">
                    <table>
                        <thead><tr><th>Line</th><th>Token</th><th>Value</th><th>Style</th><th>Anchor</th><th>Tag</th></tr></thead>
                        <tbody>
                            @foreach (var token in _result?.Tokens ?? [])
                            {
                                <tr class="token-@token.Type.ToString().ToLowerInvariant()">
                                    <td class="token-position">@token.Line:@token.Column</td>
                                    <td class="token-type" style="--depth: @token.Depth">@token.Type</td>
                                    <td class="token-text">@token.Text</td>
                                    <td>@token.Style</td>
                                    <td class="token-anchor">@(token.Anchor is null ? null : "&" + token.Anchor)</td>
                                    <td class="token-tag">@token.Tag</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (_result?.Tokens.Count >= PlaygroundEngine.MaxTokens)
                    {
                        <p class="hint">The first @PlaygroundEngine.MaxTokens.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) tokens.</p>
                    }
                </div>
            }
            else if (_outputHtml is not null)
            {
                <div class="output-code">@((MarkupString)_outputHtml)</div>
            }
            else
            {
                <pre class="code result">@_result?.Output</pre>
            }

            <footer class="status">
                @if (_result is { } result)
                {
                    @if (_view != PlaygroundView.Tokens)
                    {
                        <span>@result.DocumentCount document@(result.DocumentCount == 1 ? null : "s")</span>
                    }
                    <span title="@(_view == PlaygroundView.Tokens ? "Utf8YamlReader.Read" : "YamlDocument.Parse")">@(_view == PlaygroundView.Tokens ? "read" : "parse") @Ms(result.ParseTime)</span>
                    @if (_view is PlaygroundView.Yaml or PlaygroundView.Json && result.Error is null)
                    {
                        <span title="YamlElement.WriteTo(Utf8YamlWriter)">write @Ms(result.WriteTime)</span>
                    }
                    @if (_view == PlaygroundView.Tokens && result.Error is null)
                    {
                        <span>@result.Tokens.Count.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) tokens</span>
                    }
                }
                @if (_readyMs is { } ready)
                {
                    <span class="status-ready" title="From the first byte of the page to the first result">ready in @ready.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) ms</span>
                }
            </footer>
        </section>

        <aside class="pane options" id="options" aria-label="Options">
            <div class="options-head">
                <h2>Options</h2>
                <button type="button" class="link-button" @onclick="ResetOptions" disabled="@(_changedOptions == 0)">Reset</button>
            </div>

            <fieldset>
                <legend>Reading <a href="../guide/schemas/" title="YamlDocumentOptions">?</a></legend>
                <label class="select" title="YamlDocumentOptions.Schema: how plain scalars resolve">Schema
                    <select value="@_options.Schema" @onchange="e => Set(_options with { Schema = Parse<YamlSchemaKind>(e) })">
                        <option value="@YamlSchemaKind.Core">Core (YAML 1.2)</option>
                        <option value="@YamlSchemaKind.Yaml11">YAML 1.1</option>
                        <option value="@YamlSchemaKind.Json">JSON</option>
                        <option value="@YamlSchemaKind.Failsafe">Failsafe</option>
                    </select>
                </label>
                <label class="select" title="YamlDocumentOptions.DuplicateKeyHandling">Duplicate keys
                    <select value="@_options.DuplicateKeyHandling" @onchange="e => Set(_options with { DuplicateKeyHandling = Parse<YamlDuplicateKeyHandling>(e) })">
                        <option value="@YamlDuplicateKeyHandling.Error">Error</option>
                        <option value="@YamlDuplicateKeyHandling.LastWins">Last wins</option>
                        <option value="@YamlDuplicateKeyHandling.FirstWins">First wins</option>
                    </select>
                </label>
                <label class="check" title="YamlDocumentOptions.ResolveMergeKeys"><input type="checkbox" checked="@_options.ResolveMergeKeys" @onchange="e => Set(_options with { ResolveMergeKeys = IsChecked(e) })" /> Merge keys (<code>&lt;&lt;</code>)</label>
                <label class="check" title="YamlDocumentOptions.CommentHandling = Skip"><input type="checkbox" checked="@_options.SkipJsonComments" @onchange="e => Set(_options with { SkipJsonComments = IsChecked(e) })" /> JSON comments (<code>//</code>, <code>/* */</code>)</label>
                <label class="number" title="YamlDocumentOptions.MaxDepth, 0 for 64">Max depth <input type="number" min="0" max="@PlaygroundOptions.MaxDepthLimit" value="@_options.MaxDepth" @onchange="e => Set(_options with { MaxDepth = Math.Min(ToInt(e, _options.MaxDepth), PlaygroundOptions.MaxDepthLimit) })" /></label>
                <label class="number" title="YamlDocumentOptions.MaxAliasExpansion, 0 for the default">Max alias expansion <input type="number" min="0" step="100" value="@_options.MaxAliasExpansion" @onchange="e => Set(_options with { MaxAliasExpansion = ToInt(e, _options.MaxAliasExpansion) })" /></label>
            </fieldset>

            <fieldset>
                <legend>Layout <a href="../guide/writing-yaml/" title="YamlWriterOptions">?</a></legend>
                <label class="number" title="YamlWriterOptions.IndentSize">Indent size <input type="number" min="2" max="9" value="@_options.IndentSize" @onchange="e => Set(_options with { IndentSize = ToInt(e, _options.IndentSize) })" /></label>
                <label class="number" title="YamlWriterOptions.MaxLineWidth, 0 to fold nothing">Max line width <input type="number" min="0" step="10" value="@_options.MaxLineWidth" @onchange="e => Set(_options with { MaxLineWidth = ToInt(e, _options.MaxLineWidth) })" /></label>
                <label class="check" title="YamlWriterOptions.IndentSequences"><input type="checkbox" checked="@_options.IndentSequences" @onchange="e => Set(_options with { IndentSequences = IsChecked(e) })" /> Indent sequences</label>
                <label class="check" title="YamlWriterOptions.ExpandSequenceItems"><input type="checkbox" checked="@_options.ExpandSequenceItems" @onchange="e => Set(_options with { ExpandSequenceItems = IsChecked(e) })" /> Expand sequence items</label>
                <label class="check" title="YamlWriterOptions.IgnoreSourceStyles"><input type="checkbox" checked="@_options.IgnoreSourceStyles" @onchange="e => Set(_options with { IgnoreSourceStyles = IsChecked(e) })" /> Ignore source styles</label>
                <label class="check" title="YamlWriterOptions.Indented, for the JSON view"><input type="checkbox" checked="@_options.JsonIndented" @onchange="e => Set(_options with { JsonIndented = IsChecked(e) })" /> Indented JSON</label>
            </fieldset>

            <fieldset>
                <legend>Scalars <a href="../guide/scalar-styles/" title="YamlWriterOptions">?</a></legend>
                <label class="select" title="YamlWriterOptions.MultiLineStringStyle">Multi-line strings
                    <select value="@_options.MultiLineStringStyle" @onchange="e => Set(_options with { MultiLineStringStyle = Parse<YamlScalarStyle>(e) })">
                        <option value="@YamlScalarStyle.None">Default (literal)</option>
                        <option value="@YamlScalarStyle.Literal">Literal</option>
                        <option value="@YamlScalarStyle.Folded">Folded</option>
                        <option value="@YamlScalarStyle.DoubleQuoted">Double-quoted</option>
                    </select>
                </label>
                <label class="select" title="YamlWriterOptions.DefaultScalarStyle">Other strings
                    <select value="@_options.DefaultScalarStyle" @onchange="e => Set(_options with { DefaultScalarStyle = Parse<YamlScalarStyle>(e) })">
                        <option value="@YamlScalarStyle.None">Default (plain)</option>
                        <option value="@YamlScalarStyle.Plain">Plain</option>
                        <option value="@YamlScalarStyle.SingleQuoted">Single-quoted</option>
                        <option value="@YamlScalarStyle.DoubleQuoted">Double-quoted</option>
                        <option value="@YamlScalarStyle.Literal">Literal</option>
                        <option value="@YamlScalarStyle.Folded">Folded</option>
                    </select>
                </label>
                <label class="check" title="YamlWriterOptions.QuoteForLenientReaders"><input type="checkbox" checked="@_options.QuoteForLenientReaders" @onchange="e => Set(_options with { QuoteForLenientReaders = IsChecked(e) })" /> Quote for lenient readers</label>
            </fieldset>

            <p class="hint">Styml @StymlVersion, running in your browser with WebAssembly. Source styles apply unless <em>Ignore source styles</em> is set.</p>
        </aside>
    </main>
</div>

@code {
    private RenderFragment RenderNode(PlaygroundNode node) =>
        @<li class="node node-@node.Kind">
            <div class="node-line">
                @if (node.Key is not null)
                {
                    <span class="node-key @(node.ComplexKey ? "node-key-complex" : null)" title="@(node.ComplexKey ? "A collection key" : null)">@node.Key</span><span class="node-colon">:</span>
                }
                @if (node.IsAlias)
                {
                    <span class="node-alias" title="An alias of the node anchored &@node.Anchor">*@node.Anchor</span>
                }
                else if (node.Anchor is not null)
                {
                    <span class="node-anchor" title="Anchor">&amp;@node.Anchor</span>
                }
                @if (node.Tag is not null)
                {
                    <span class="node-tag" title="Tag, expanded">@node.Tag</span>
                }
                @if (node.Kind == "scalar")
                {
                    <span class="node-value node-value-@node.Type" title="@node.Type">@(node.Value?.Replace("\n", "↵"))</span>
                }
                else
                {
                    <span class="node-kind">@node.Kind@(node.IsAlias ? null : $" ({node.Children.Count})")</span>
                }
                <span class="node-meta">@(node.Kind == "scalar" ? node.Type : null) @node.Style</span>
            </div>
            @if (node.Children.Count > 0)
            {
                <ul>
                    @foreach (var child in node.Children)
                    {
                        @RenderNode(child)
                    }
                </ul>
            }
        </li>;
}
